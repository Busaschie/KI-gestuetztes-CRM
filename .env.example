DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DATABASE_URL=postgres://sandra:sandra@localhost:5432/sandra_crm

# Sprachmodell: mistral (Betrieb, EU) | ollama (lokal, Entwicklung)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=1800
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# CV-Postfach (IMAP) – Daten vom Hoster (febas)
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=True
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Optional: verarbeitete Mails in diesen Ordner verschieben (muss existieren), sonst nur "gelesen"
IMAP_PROCESSED_FOLDER=

# Versand-Postfach (SMTP) – eigenes Postfach, nicht das CV-Postfach
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # ohne = Mails nur im Terminal (lokal)
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=
EMAIL_REPLY_TO=
OUTBOUND_STOP_MINUTES=60

# E-Signatur: documenso (Betrieb) | fake (Entwicklung/Tests)
SIGNATURE_PROVIDER=fake

# Telegram-Bot (Token von @BotFather). Chat-ID: im Bot /start senden, Antwort hier eintragen (mehrere mit Komma)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_BRIEFING_TIME=07:30

# Sprachnachrichten → Text: whisper (lokal, pip install faster-whisper) | mistral (Voxtral, EU) | fake
TRANSCRIBE_PROVIDER=whisper
TRANSCRIBE_LANGUAGE=
WHISPER_MODEL=small
MISTRAL_TRANSCRIBE_MODEL=voxtral-mini-latest
# True = Sprachnachrichten über qcluster verarbeiten (Bot antwortet währenddessen weiter); False = direkt im Bot
TELEGRAM_ASYNC=False
# Namen der zuletzt bearbeiteten Personen als Hinweis für Whisper (0 = aus)
TRANSCRIBE_NAME_HINTS=50

# Verträge: Stopp-Fenster in Minuten vor dem Versand, Erinnerungen an den Kunden nach X Tagen
CONTRACT_STOP_MINUTES=60
CONTRACT_REMINDER_DAYS=3,7
CONTRACT_REMINDER_TIME=09:00

# Zeitzone für Anzeige, Briefing und Stopp-Fenster (Betrieb: Europe/Bucharest)
TIME_ZONE=Europe/Bucharest

# Vertrags-PDF (eigenes Layout, apps/clients/contract_pdf.py)
CONTRACT_GOVERNING_LAW=österreichisches Recht
# Auftragnehmerin (steht im Vertrag); Adresszeilen mit | trennen
CONTRACTOR_NAME=
CONTRACTOR_ADDRESS=
CONTRACTOR_TAX_ID=
CONTRACTOR_SIGNER=

# Documenso (Open Source, selbst gehostet) – SIGNATURE_PROVIDER=documenso
# Webhook in Documenso: https://<server>/clients/documenso/webhook/ + gleiches Geheimnis (Header X-Documenso-Secret)
DOCUMENSO_API_URL=http://localhost:3001/api/v2
DOCUMENSO_API_KEY=
DOCUMENSO_WEBHOOK_SECRET=
