DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DATABASE_URL=postgres://sandra:sandra@localhost:5432/sandra_crm

# Sprachmodell: mistral (Betrieb, EU) | ollama (lokal, Entwicklung)
LLM_PROVIDER=ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT=1800
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# CV-Postfach (IMAP) – Daten vom Hoster (febas)
IMAP_HOST=
IMAP_PORT=993
IMAP_SSL=True
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX
# Optional: verarbeitete Mails in diesen Ordner verschieben (muss existieren), sonst nur "gelesen"
IMAP_PROCESSED_FOLDER=

# E-Signatur: docuseal (Betrieb) | fake (Entwicklung/Tests)
SIGNATURE_PROVIDER=fake
DOCUSEAL_API_URL=https://api.docuseal.eu
DOCUSEAL_API_KEY=
DOCUSEAL_TEMPLATE_ID=
DOCUSEAL_SIGNER_ROLE=First Party
# Webhook in DocuSeal: URL https://<server>/clients/docuseal/webhook/ + eigener Header mit diesem Geheimnis
DOCUSEAL_WEBHOOK_HEADER=X-Docuseal-Secret
DOCUSEAL_WEBHOOK_SECRET=
